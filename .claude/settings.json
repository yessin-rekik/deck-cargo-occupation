{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "default",
  "language": "english",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  },
  "showTurnDuration": true,
  "autoUpdatesChannel": "stable"
}